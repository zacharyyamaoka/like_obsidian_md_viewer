{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noFallthroughCasesInSwitch": true,
    "strict": true

    /* WHY no noUnusedLocals/noUnusedParameters/erasableSyntaxOnly: per
       UPSTREAM.md, everything outside src/obsidian/ is upstream's tree,
       verbatim — it uses constructor parameter properties and carries one
       deliberately-unused import (searchPanel.ts) to stay diffable against
       atomic-editor. House lint strictness doesn't apply to someone else's
       tree we're merging patches into. */
  },
  "include": ["src"]
}
